{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }} · {{ parent() }}{% endblock %}

{% block body %}
    <div class="col-md-6 col-lg-4 mx-auto">
        <h1 class="mb-4">{{ 'login.title'|trans }}</h1>

        {% if error %}
            {# Symfony ships these messages translated in the "security" domain. #}
            <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <div class="mb-3">
                <label class="form-label" for="username">{{ 'user.field.email'|trans }}</label>
                <input class="form-control" type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">{{ 'user.field.password'|trans }}</label>
                <input class="form-control" type="password" id="password" name="_password" autocomplete="current-password" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button class="btn btn-primary w-100">{{ 'login.submit'|trans }}</button>
        </form>

        <p class="mt-3">{{ 'login.no_account'|trans }} <a href="{{ path('app_register') }}">{{ 'nav.register'|trans }}</a></p>
    </div>
{% endblock %}
