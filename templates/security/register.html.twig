{% extends 'base.html.twig' %}

{% block title %}{{ 'register.title'|trans }} · {{ parent() }}{% endblock %}

{% block body %}
    <div class="col-md-8 col-lg-5 mx-auto">
        <h1 class="mb-4">{{ 'register.title'|trans }}</h1>
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-primary w-100">{{ 'register.submit'|trans }}</button>
        {{ form_end(form) }}
        <p class="mt-3">{{ 'register.has_account'|trans }} <a href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a></p>
    </div>
{% endblock %}
